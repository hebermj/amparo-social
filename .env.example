# Telegram
TELEGRAM_BOT_TOKEN=

# LLM Providers (pelo menos um)
OPENCODE_ZEN_API_KEY=
OPENROUTER_API_KEY=

# Banco de Dados (PostgreSQL) — memória persistente por usuário.
# Se não for configurado, o bot usa memória volátil (em desenvolvimento).
DATABASE_URL=postgresql://user:***@host:5432/amparo_social

# Busca Web (pelo menos um)
# Opção A: SearXNG self-hosted (recomendado) — usado sempre que alcançável.
# Pode apontar para o seu próprio servidor/PC (ex.: http://192.168.1.100:4000
# em rede local, ou um URL HTTPS público quando deployado na Vercel).
SEARXNG_URL=http://localhost:4000
SEARXNG_API_KEY=
# Opção B: SearXNG comunitário — usado automaticamente se o self-hosted falhar.
# Lista default contém apenas instâncias verificadas com format=json; pode
# sobrescrever com SEARXNG_COMMUNITY_INSTANCES (URLs separadas por vírgula).
SEARXNG_COMMUNITY_INSTANCES=https://search.mectov.my.id

# Cidade usada como padrão quando o usuário não informou a sua.
# O bot funciona para qualquer cidade — esta é só a padrão inicial.
CIDADE_PADRAO=Santo André
