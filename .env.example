# Telegram
TELEGRAM_BOT_TOKEN=

# LLM Providers (pelo menos um)
OPENCODE_ZEN_API_KEY=
OPENROUTER_API_KEY=

# Banco de Dados (PostgreSQL) — memória persistente por usuário.
# Se não for configurado, o bot usa memória volátil (em desenvolvimento).
DATABASE_URL=postgresql://user:***@host:5432/amparo_social

# Busca Web — Instância SearXNG Própria (única provedora, ADR-0006).
# Sem fallback para instâncias comunitárias: se a Instância estiver
# indisponível, a Recomendação sai só da Base de Atividades.
# SEARXNG_URL aponta para o túnel público HTTPS da Instância.
SEARXNG_URL=http://localhost:8080
# Credencial basic auth que o Amparo envia à Instância (Caddy).
SEARXNG_USER=
SEARXNG_PASSWORD=

# Cidade usada como padrão quando o usuário não informou a sua.
# O bot funciona para qualquer cidade — esta é só a padrão inicial.
CIDADE_PADRAO=Santo André
