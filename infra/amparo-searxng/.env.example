# Stack da Instância SearXNG Própria do Amparo (ADR-0006).
#
# NÃO copie este arquivo manualmente: rode ./setup.sh, que gera o .env
# com senha forte, segredo e o hash bcrypt já escapado para o
# Docker Compose (`$$` no lugar de `$`, pois o compose interpola $VAR).
SEARXNG_USER=amparo_bot
SEARXNG_PASSWORD=
SEARXNG_PASSWORD_BCRYPT=
SEARXNG_SECRET=

# ── Uso ──────────────────────────────────────────────────────────
#   docker compose up -d
#   curl -u "$SEARXNG_USER:$SEARXNG_PASSWORD" "http://127.0.0.1:8080/search?q=caminhada&format=json"
#   curl -i "http://127.0.0.1:8080/search?q=caminhada&format=json"   # → 401
